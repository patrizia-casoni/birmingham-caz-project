      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "Column1",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "53a70121-3430-4bb6-be8a-60256e03d8ed",
            "sourceColumn": "Column1",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "56623d63-ec1c-45aa-89df-3354df0881c1",
        "measures": [
          {
            "name": "Dynamic Transparency",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "expression": [
              "",
              "IF (",
              "    MAX('public vw_caz_and_wards_map'[layer_type]) = \"CAZ Boundary\",",
              "    100, ",
              "    0    ",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "6be363b6-d9f0-4a13-9db2-91b658ebae3e"
          },
          {
            "name": "Single_Map_Tooltip",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "expression": [
              "",
              "IF(",
              "    SELECTEDVALUE('public vw_caz_and_sites_map'[site_id]) <> BLANK(),",
              "    ",
              "    -- FORMATTING FOR MONITORING SITES (No prefixes):",
              "    SELECTEDVALUE('public vw_caz_and_sites_map'[map_label]) & UNICHAR(10) &",
              "    SELECTEDVALUE('public vw_caz_and_sites_map'[site_type]) & UNICHAR(10) &",
              "    FORMAT(SELECTEDVALUE('public vw_caz_and_sites_map'[distance_to_caz_metres]) / 1000, \"0.0\") & \" km\",",
              "",
              "    -- FORMATTING FOR CAZ TIERS:",
              "    SELECTEDVALUE('public vw_caz_and_sites_map'[map_label])",
              ")"
            ],
            "lineageTag": "095248d8-8592-4146-a70a-d13f35d80055"
          },
          {
            "name": "NO2_Avg_2018",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE('public analytics_site_yearly_summary'[annualised_mean]),",
              "    'public analytics_site_yearly_summary'[year] = 2018,",
              "    REMOVEFILTERS('public dim_years') ",
              ")"
            ],
            "lineageTag": "c8c8f7fe-dd8f-41f6-aa62-5489d9f6acb7"
          },
          {
            "name": "NO2_%_Change",
            "expression": [
              "",
              "VAR Avg2018 = [NO2_Avg_2018]",
              "VAR AvgCurrent = AVERAGE('public analytics_site_yearly_summary'[annualised_mean])",
              "RETURN",
              "DIVIDE(AvgCurrent - Avg2018, Avg2018)"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "e0f6380a-b1db-42ae-a0e3-ca60b7709c0b"
          },
          {
            "name": "998_Perc_18/19_Baseline",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR StandardBaseline = ",
              "    CALCULATE(",
              "        AVERAGE('public analytics_site_yearly_summary'[p998_no2_value]),",
              "        'public analytics_site_yearly_summary'[year] IN {2018, 2019},",
              "        REMOVEFILTERS('public dim_years')",
              "    )",
              "",
              "VAR FallbackBaseline2022 = ",
              "    CALCULATE(",
              "        AVERAGE('public analytics_site_yearly_summary'[p998_no2_value]),",
              "        'public analytics_site_yearly_summary'[year] = 2022,",
              "        REMOVEFILTERS('public dim_years')",
              "    )",
              "",
              "RETURN ",
              "    IF(ISBLANK(StandardBaseline), FallbackBaseline2022, StandardBaseline)"
            ],
            "lineageTag": "0473c705-976f-45e7-bda4-99afd50c8bc3"
          },
          {
            "name": "998_Perc_%_Change_Dynamic",
            "expression": [
              "",
              "DIVIDE(",
              "    [P998_Dynamic_Value] - [998_Perc_18/19_Baseline],",
              "    [998_Perc_18/19_Baseline]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "addad2f0-34e2-4cdf-8f7c-10cf6d4f4b8c"
          },
          {
            "name": "P998_Dynamic_Value",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR CurrentValue = AVERAGE('public analytics_site_yearly_summary'[p998_no2_value])",
              "",
              "VAR LastValidYear = ",
              "    CALCULATE(",
              "        MAX('public analytics_site_yearly_summary'[year]),",
              "        NOT ISBLANK('public analytics_site_yearly_summary'[p998_no2_value]),",
              "        REMOVEFILTERS('public dim_years')",
              "    )",
              "    ",
              "VAR FallbackValue = ",
              "    CALCULATE(",
              "        AVERAGE('public analytics_site_yearly_summary'[p998_no2_value]),",
              "        'public dim_years'[calendar_year] = LastValidYear,",
              "        REMOVEFILTERS('public dim_years')",
              "    )",
              "    ",
              "RETURN ",
              "    IF(ISBLANK(CurrentValue), FallbackValue, CurrentValue)"
            ],
            "lineageTag": "caef21ee-269b-4a0b-84d5-92b83a082316"
          },
          {
            "name": "Pollution Load % Change (2022-2025)",
            "expression": [
              "",
              "VAR Load2022 = ",
              "    CALCULATE(",
              "        [Estimated Pollution Load], ",
              "        'public vw_powerbi_traffic'[year] = 2022",
              "    )",
              "",
              "VAR Load2025 = ",
              "    CALCULATE(",
              "        [Estimated Pollution Load], ",
              "        'public vw_powerbi_traffic'[year] = 2025",
              "    )",
              "",
              "RETURN",
              "    DIVIDE(Load2025 - Load2022, Load2022, 0)"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "547fa5d0-c1fe-47e4-b93a-28e77f7050ad"
          },
          {
            "name": "Map Smart Filter",
            "expression": [
              "",
              "VAR SelectedWards = VALUES('Map Remote Control'[area_name])",
              "VAR CurrentLayer = MAX('public vw_caz_and_wards_map'[layer_type])",
              "VAR CurrentWard = MAX('public vw_caz_and_wards_map'[area_name])",
              "",
              "RETURN",
              "IF(",
              "    CurrentLayer = \"CAZ Boundary\",",
              "    1, -- Always return 1 to protect and show the CAZ rings",
              "    IF(",
              "        ISFILTERED('Map Remote Control'[area_name]),",
              "        IF(CurrentWard IN SelectedWards, 1, 0), -- Show 1 if selected, 0 if not",
              "        1 -- Show everything (return 1) if nothing is selected in the slicer",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "9a34879f-9080-4de8-8270-3f73e47014e2"
          },
          {
            "name": "Show on Map",
            "expression": [
              "",
              "VAR SelectedWards = VALUES('Map Remote Control'[area_name])",
              "VAR CurrentLayer = MAX('public vw_caz_and_wards_map'[layer_type])",
              "VAR CurrentWard = MAX('public vw_caz_and_wards_map'[area_name])",
              "",
              "RETURN",
              "IF(",
              "    CurrentLayer = \"CAZ Boundary\",",
              "    1, -- Protects the rings and keeps them visible",
              "    IF(",
              "        -- Look at BOTH levels of the slicer hierarchy:",
              "        ISFILTERED('Map Remote Control'[area_name]) || ISFILTERED('Map Remote Control'[caz_tier]), ",
              "        IF(CurrentWard IN SelectedWards, 1, 0), -- Show only the wards inside the selected tier/ward",
              "        1 -- Show all wards if the slicer is completely empty",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "d6697cda-efdf-4221-ac70-61350b876224"
          },
          {
            "name": "COPD Rate",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE('public vw_ward_hospital_admissions'[standardised_rate]),",
              "    'public vw_ward_hospital_admissions'[health_condition] = \"COPD\",",
              "    -- This TREATAS function acts as an invisible bridge, pushing the selected year from your slicer directly into this calculation without breaking the map!",
              "    TREATAS(",
              "        VALUES('public dim_years'[fiscal_year]), ",
              "        'public vw_ward_hospital_admissions'[fiscal_year]",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "e12ce8db-2830-4240-b717-0aca27501b15"
          },
          {
            "name": "Map Fill Scale Resp",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "IF(",
              "    MAX('public vw_caz_and_wards_map'[layer_type]) = \"CAZ Boundary\",",
              "    -1,            -- Gives the CAZ rings a negative dummy value",
              "    [Resp Disease Rate]    -- Passes the true COPD score for the wards",
              ")"
            ],
            "lineageTag": "c4d7e1fd-24f3-4def-9de7-1db06e8dcf17"
          },
          {
            "name": "Resp Disease Rate",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE('public vw_ward_hospital_admissions'[standardised_rate]),",
              "    'public vw_ward_hospital_admissions'[health_condition] = \"Respiratory Disease\",",
              "    -- This TREATAS function acts as an invisible bridge, pushing the selected year from your slicer directly into this calculation without breaking the map!",
              "    TREATAS(",
              "        VALUES('public dim_years'[fiscal_year]), ",
              "        'public vw_ward_hospital_admissions'[fiscal_year]",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "80294519-4284-4f3c-8dcf-cc0a9f4bada5"
          },
          {
            "name": "Map Fill Scale COPD",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "IF(",
              "    MAX('public vw_caz_and_wards_map'[layer_type]) = \"CAZ Boundary\",",
              "    -1,            -- Gives the CAZ rings a negative dummy value",
              "    [COPD Rate]    -- Passes the true COPD score for the wards",
              ")"
            ],
            "lineageTag": "bd4ebce4-9435-4174-b187-209f8f7e9d99"
          },
          {
            "name": "COPD YoY % Change",
            "expression": [
              "",
              "VAR CurrentYearText = MAX('public dim_years'[fiscal_year])",
              "VAR CurrentYearValue = [COPD Rate]",
              "",
              "-- Calculate the previous year's text string",
              "VAR PrevYearStart = VALUE(LEFT(CurrentYearText, 4)) - 1",
              "VAR PrevYearEnd = RIGHT(LEFT(CurrentYearText, 4), 2)",
              "VAR PrevYearString = PrevYearStart & \"/\" & PrevYearEnd",
              "",
              "-- Fetch the COPD rate for that previous year",
              "VAR PreviousYearValue = ",
              "    CALCULATE(",
              "        [COPD Rate],",
              "        REMOVEFILTERS('public dim_years'[fiscal_year]),",
              "        'public dim_years'[fiscal_year] = PrevYearString",
              "    )",
              "",
              "RETURN",
              "-- Only calculate the change if BOTH years have actual data",
              "IF(",
              "    NOT ISBLANK(CurrentYearValue) && NOT ISBLANK(PreviousYearValue),",
              "    DIVIDE(CurrentYearValue - PreviousYearValue, PreviousYearValue)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "51d74c38-cf35-411d-b1fd-b317ef0f2041"
          },
          {
            "name": "Resp Disease YoY % Change",
            "expression": [
              "",
              "VAR CurrentYearText = MAX('public dim_years'[fiscal_year])",
              "VAR CurrentYearValue = [Resp Disease Rate]",
              "",
              "-- Calculate the previous year's text string",
              "VAR PrevYearStart = VALUE(LEFT(CurrentYearText, 4)) - 1",
              "VAR PrevYearEnd = RIGHT(LEFT(CurrentYearText, 4), 2)",
              "VAR PrevYearString = PrevYearStart & \"/\" & PrevYearEnd",
              "",
              "-- Fetch the COPD rate for that previous year",
              "VAR PreviousYearValue = ",
              "    CALCULATE(",
              "        [Resp Disease Rate],",
              "        REMOVEFILTERS('public dim_years'[fiscal_year]),",
              "        'public dim_years'[fiscal_year] = PrevYearString",
              "    )",
              "",
              "RETURN",
              "-- Only calculate the change if BOTH years have actual data",
              "IF(",
              "    NOT ISBLANK(CurrentYearValue) && NOT ISBLANK(PreviousYearValue),",
              "    DIVIDE(CurrentYearValue - PreviousYearValue, PreviousYearValue)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "5f0d1fd1-2dff-40e8-9194-71cfd845c313"
          },
          {
            "name": "COPD % Change (19/20 to 24/25)",
            "expression": [
              "",
              "-- 1. Grab the Pre-CAZ Baseline (2019/20)",
              "VAR BaselineValue = ",
              "    CALCULATE(",
              "        [COPD Rate],",
              "        'public dim_years'[fiscal_year] = \"2019/20\",",
              "        REMOVEFILTERS('public dim_years')",
              "    )",
              "",
              "-- 2. Grab the Current State (2024/25)",
              "VAR CurrentValue = ",
              "    CALCULATE(",
              "        [COPD Rate],",
              "        'public dim_years'[fiscal_year] = \"2024/25\",",
              "        REMOVEFILTERS('public dim_years')",
              "    )",
              "",
              "RETURN",
              "-- 3. Calculate the overall percentage change",
              "IF(",
              "    NOT ISBLANK(BaselineValue) && NOT ISBLANK(CurrentValue),",
              "    DIVIDE(CurrentValue - BaselineValue, BaselineValue)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "d6b2bec1-9ab5-477a-9771-82a24b371119"
          },
          {
            "name": "Resp Disease % Change (19/20 to 24/25)",
            "expression": [
              "",
              "-- 1. Grab the Pre-CAZ Baseline (2019/20)",
              "VAR BaselineValue = ",
              "    CALCULATE(",
              "        [Resp Disease Rate],",
              "        'public dim_years'[fiscal_year] = \"2019/20\",",
              "        REMOVEFILTERS('public dim_years')",
              "    )",
              "",
              "-- 2. Grab the Current State (2024/25)",
              "VAR CurrentValue = ",
              "    CALCULATE(",
              "        [Resp Disease Rate],",
              "        'public dim_years'[fiscal_year] = \"2024/25\",",
              "        REMOVEFILTERS('public dim_years')",
              "    )",
              "",
              "RETURN",
              "-- 3. Calculate the overall percentage change",
              "IF(",
              "    NOT ISBLANK(BaselineValue) && NOT ISBLANK(CurrentValue),",
              "    DIVIDE(CurrentValue - BaselineValue, BaselineValue)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "88c15943-a609-443a-a3b5-36cd225a0335"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Column1\", type text}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
