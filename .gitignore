# =====================================
# Power BI Project (PBIP) Exclusions
# =====================================
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.manifest
*.lock
~*.*
*.abf
*.smb

# =====================================
# Raw Data Files (Prevent Git Repo Bloat)
# =====================================
# It is best practice to exclude raw data files so they don't slow down Git data/
*.csv
*.geojson
*.xlsx

# =====================================
# DBeaver / Local IDE Settings
# =====================================
.dbeaver/
.project
.settings/
.vscode/

# =====================================
# OS Generated Clutter
# =====================================
.DS_Store
Thumbs.db

# =====================================
# Scratchpads and Temp Files
# =====================================
scratchpad.sql